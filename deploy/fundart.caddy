fundart.mskpoeira.com.br {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        -Server
    }

    # Entradas administrativas amigáveis enquanto o WordPress é homologado.
    redir /wp-admin /homologacao/wp-admin/ 302
    redir /wp-admin/ /homologacao/wp-admin/ 302
    redir /wp-login.php /homologacao/wp-login.php 302

    # Homologação WordPress isolada, sem substituir o portal estático.
    redir /homologacao /homologacao/ 308
    handle_path /homologacao/* {
        reverse_proxy 127.0.0.1:63252 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Prefix /homologacao
        }
    }
    handle {
        reverse_proxy 127.0.0.1:63250
    }
}
